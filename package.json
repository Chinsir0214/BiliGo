{
  "name": "bili-go",
  "version": "1.2.0",
  "description": "A focused Bilibili downloader powered by yt-dlp and ffmpeg.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/tools.js && node --check src/renderer.js && node --check src/download/constants.js && node --check src/download/formats.js && node --check src/download/request.js && node --check src/download/task.js && node --check src/download/queue.js && node --check src/download/executor.js",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "typescript-language-server": "^5.3.0",
    "vscode-langservers-extracted": "^4.10.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "qrcode": "^1.5.3"
  },
  "build": {
    "appId": "com.biligo.app",
    "productName": "BiliGo",
    "icon": "assets/icon.png",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "tools",
        "to": "tools",
        "filter": [
          "yt-dlp.exe",
          "ffmpeg.exe"
        ]
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "portable"
      ],
      "executableName": "BiliGo"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true
    },
    "portable": {
      "artifactName": "BiliGo-${version}-portable.exe"
    },
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "Chinsir0214",
      "repo": "BiliGo",
      "releaseType": "release"
    }
  }
}
