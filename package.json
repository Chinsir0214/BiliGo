{
  "name": "bili-go",
  "version": "1.1.1",
  "description": "A focused Bilibili downloader powered by yt-dlp and ffmpeg.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/tools.js && node --check src/renderer.js",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "qrcode": "^1.5.3"
  },
  "build": {
    "appId": "com.biligo.app",
    "productName": "BiliGo",
    "icon": "assets/icon.png",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "tools",
        "to": "tools",
        "filter": [
          "yt-dlp.exe",
          "ffmpeg.exe"
        ]
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "portable"
      ],
      "executableName": "BiliGo"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true
    },
    "portable": {
      "artifactName": "BiliGo-${version}-portable.exe"
    },
    "directories": {
      "output": "release"
    }
  }
}
